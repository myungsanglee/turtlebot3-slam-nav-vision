<?xml version="1.0" ?>
<!-- =============================================================================
  turtlebot3_burger.urdf  (커스텀 로봇 보정판, turtlebot3-slam-nav-vision)

  ROBOTIS 표준 turtlebot3_burger.urdf 에서 실물 실측값으로 센서 TF 만 보정한 파일.
  bringup 의 robot_state_publisher 가 이 URDF 를 로드해 /tf_static 을 publish 한다.

  [표준 대비 변경] (실측 기반)
   1) scan_joint (LDS 라이다)   xyz -0.032,0,0.172  =>  -0.100,0,0.125
      바퀴 축에서 뒤로 100mm, 중앙, base_link 기준 높이 125mm (낮게 개조).
      이 값이 실물과 어긋나면 제자리 회전 시 지도 벽이 이중으로 번진다.
   2) imu_joint (OpenCR/IMU)    rpy 0,0,0  =>  0,0,-1.57
      OpenCR 을 위에서 시계방향 90도 회전 장착 (yaw=-90도).
      ※ IMU 위치 xyz 는 미실측이라 표준값 유지. EKF 단계 전 실측 교체할 것.
   3) RealSense D435i 추가 (표준엔 없음)
      base_link 에서 카메라 바닥 1/4인치 마운트 나사 구멍까지 실측 => x +47.5mm, y 0, z +48mm, 수평 장착.
      나사 구멍 아래 프레임 체인(camera_link, depth/color, optical)은 인텔 공식 URDF 상수 그대로.

  바퀴 폭은 표준과 동일하므로 wheel_*/base_joint 등은 미변경.
  상세 설명은 docs/description.md 참고.

  ※ 주의) URDF 주석에 콜론+공백 이나 줄 끝 콜론을 쓰면 bringup 의
     robot_description YAML 파싱이 깨진다(mapping values 오류). 주석에 콜론 금지.
============================================================================= -->
<robot name="turtlebot3_burger"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="${namespace}base_footprint"/>

  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.2573504e-01"/>
      <inertia ixx="2.2124416e-03" ixy="-1.2294101e-05" ixz="3.4938785e-05" iyy="2.1193702e-03" iyz="-5.0120904e-06" izz="2.0064271e-03" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_left_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_right_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <joint name="${namespace}caster_back_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- IMU (OpenCR) 위에서 시계방향 90도 회전 장착 => yaw=-1.57 (실측 보정).
       위치 xyz 는 표준값 유지 - EKF 단계 전 실측 교체 필요. -->
  <joint name="${namespace}imu_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 -1.57"/>
  </joint>

  <link name="${namespace}imu_link"/>

  <!-- LDS 라이다 실측 보정 - 바퀴축에서 뒤로 100mm, 중앙, base_link 기준 높이 125mm. -->
  <joint name="${namespace}scan_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}base_scan"/>
    <origin xyz="-0.100 0 0.125" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- RealSense D435i (실측 + 인텔 공식 오프셋) — 2026-09-08 실측
       base_link -> camera_bottom_screw_frame (바닥 1/4인치 마운트 나사 구멍)  실측 x +47.5mm, y 0, z +48mm
       수평 장착 가정 (rpy 0 0 0). 기울어져 있으면 아래 camera_mount_joint 의 pitch 만 수정.
       나사 구멍 이하는 인텔 realsense2_description 의 _d435.urdf.xacro 상수를 그대로 옮긴 것 -
         camera_link = 왼쪽 IR 이미저(depth 원점) = 나사 구멍에서 x +10.6, y +17.5, z +12.5 mm
         camera_color_frame = camera_link 에서 y +15mm (RGB 렌즈는 왼쪽 IR 의 왼쪽)
         optical 프레임 = 같은 위치, 축만 광학 규약(z 앞, x 오른쪽, y 아래)으로 회전
       우리 카메라의 공장 익스트린식(depth-color 14.9mm)과 일치 확인. 자체 카메라 노드는
       모든 출력을 camera_color_optical_frame 기준으로 publish 한다 (docs/realsense_bringup.md). -->
  <joint name="${namespace}camera_mount_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}camera_bottom_screw_frame"/>
    <origin xyz="0.0475 0 0.048" rpy="0 0 0"/>
  </joint>
  <link name="${namespace}camera_bottom_screw_frame"/>

  <joint name="${namespace}camera_link_joint" type="fixed">
    <parent link="${namespace}camera_bottom_screw_frame"/>
    <child link="${namespace}camera_link"/>
    <origin xyz="0.0106 0.0175 0.0125" rpy="0 0 0"/>
  </joint>
  <link name="${namespace}camera_link">
    <visual>
      <!-- 몸체 90 x 25 x 25 mm 상자 (RViz 표시용). 몸체 중심은 camera_link 기준 x -8.2, y -17.5 mm -->
      <origin xyz="-0.0082 -0.0175 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02505 0.090 0.025"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <inertial>
      <mass value="0.072" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="${namespace}camera_depth_joint" type="fixed">
    <parent link="${namespace}camera_link"/>
    <child link="${namespace}camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="${namespace}camera_depth_frame"/>

  <joint name="${namespace}camera_depth_optical_joint" type="fixed">
    <parent link="${namespace}camera_depth_frame"/>
    <child link="${namespace}camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="${namespace}camera_depth_optical_frame"/>

  <joint name="${namespace}camera_color_joint" type="fixed">
    <parent link="${namespace}camera_link"/>
    <child link="${namespace}camera_color_frame"/>
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
  </joint>
  <link name="${namespace}camera_color_frame"/>

  <joint name="${namespace}camera_color_optical_joint" type="fixed">
    <parent link="${namespace}camera_color_frame"/>
    <child link="${namespace}camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="${namespace}camera_color_optical_frame"/>

</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realsense_bringup</name>
  <version>0.1.0</version>
  <description>
    RealSense D435i 카메라 실행 런치 (Raspberry Pi 에서 실행).
    realsense2_camera 노드를 커스텀 로봇에 맞춘 옵션으로 띄워 color/depth 를
    /camera/* 토픽으로 publish 한다. bringup 은 건드리지 않고 카메라만 추가.
  </description>
  <maintainer email="mslee@robotegra.com">Myungsang Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
